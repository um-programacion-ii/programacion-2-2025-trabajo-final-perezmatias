// --- DEFINICIÓN DE EVENTO (Queda igual) ---
entity Evento {
    titulo String required,
    descripcion String,
    fechaHora Instant required,
    ubicacion String,
    precio BigDecimal required min(0)
}

// --- DEFINICIÓN DE VENTA (MODIFICADA) ---
entity Venta {
    fechaVenta Instant required,
    total BigDecimal required min(0),
    asientos String required,
    // Nuevos campos para identificar al comprador sin login
    nombreComprador String required,
    dniComprador String required
}

// --- RELACIONES ---
relationship ManyToOne {
    Venta{evento(titulo) required} to Evento
    // NOTA: Hemos eliminado la relación "Venta -> User"
}

// --- CONFIGURACIÓN ---
paginate Venta, Evento with pagination
service Venta, Evento with serviceClass
